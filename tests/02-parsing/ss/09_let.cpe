def t37 : T = let x = 1 in x + 2
def l1 : T = let x = 1 in x
def l2 : T = let x = 1 and y = 2 in x + y
def l3 : T = let f (n : Integer) : Integer = n + 1 in f 2
def l4 : T =
  let f (n : Integer) : Integer = if n == 0 then 0 else g (n - 1)
  and g (n : Integer) : Integer = if n == 0 then 1 else f (n - 1)
  in f 10
def l5 : T = let x = 1 in let y = x + 1 in y * 2
def l6 : T = let x = let y = 1 in y in x
def l7 : T = let f () : Integer = 0 in f ()
def l8 : T = let f (a : Integer) (b : Integer) : Integer = a + b in f 1 2
