# ---- definitions: variables, unit parameter, several parameters
def x : Integer = 1
def unit_fn () : Integer = 0
def one (a : Integer) : Integer = a
def two (a : Integer) (b : Integer) : Integer = a + b
def mixed (a : Integer) () (b : [a]) : Integer = 0
def poly (f : a -> b) (xs : [a]) : [b] = map f xs

# ---- application
def a1 : T = f x
def a2 : T = f x y z
def a3 : T = f (g x) (h y)
def a4 : T = map parseInt                      # partial application
def a5 : T = lib!fun 1 2
def a6 : T = f ()
def a7 : T = f []
def a8 : T = (f x) y
def a9 : T = f (1, 2)
def a10 : T = (1, 2)
def a11 : T = (1, (2, 3))
def a18 : T = Node 1 Leaf Leaf
def t23 : T = f g h

# ---- composition (.) and application ($)
def t17 : T = f $ a || b
def t18 : T = f $ g $ x
def t19 : T = f . g . h
def t20 : T = f . g $ x
def t21 : T = f x . g y
def t41 : T = (f . g) x
def t42 : T = f . (g x)
def t43 : T = not . p $ x || y
def t46 : T = a :: b $ c

# ---- lambda
def a12 : T = (\ (x : Integer) : Integer => x + 1) 41
def a13 : T = \ (x : Integer) (y : Integer) : Integer => x * y
def a14 : T = \ () : Integer => 0
def a15 : T = map (\ (x : Integer) : Integer => x + 1) xs
def a16 : T = \ (f : a -> b) : (a -> b) => f
def a17 : T = \ (x : Integer) : Integer -> Integer => \ (y : Integer) : Integer => x + y
