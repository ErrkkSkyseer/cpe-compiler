# type synonyms
type String2 = [Char]
type Endomap s = Map s s
type Pair a b = (a, b)
type Fun a b = a -> b
type Curried = Integer -> Integer -> Integer
type Higher = (Integer -> Integer) -> Integer
type Nested = [[Integer]]
type Applied a = Either () (Tree a)
type Parens = (Integer)
type FnPair = (a -> b, [c])

# type expressions in signatures
def t1 (f : a -> b -> c) (g : (a -> b) -> c) (p : (a, b)) : c = f
def t2 (xs : [[a]]) (t : Tree a) (e : Either a b) (u : ()) : Tree (Tree a) = t
def t3 (x : Integer) : ([a], [a]) = x
def t4 (f : a -> (b -> c)) : a -> b -> c = f
def t5 (m : Map String [Integer]) : Maybe (Either a b) = m
def t6 (x : Bool) (y : Char) (z : Double) (w : Integer) : String = x
