# integer literals
def i0 : Integer = 0
def i1 : Integer = 42
def imax : Integer = 4611686018427387903   # 2^62 - 1

# floating-point literals
def f1 : Double = 3.14
def f2 : Double = 0.5
def f3 : Double = 1.5e10
def f4 : Double = 2.0E-3
def f5 : Double = 1e3

# character literals and every escape sequence
def c1 : Char = 'a'
def c2 : Char = ' '
def c3 : Char = '\n'
def c4 : Char = '\''
def c5 : Char = '\\'
def c6 : Char = '"'
def c7 : Char = '\t'
def c8 : Char = '\r'
def c9 : Char = '\b'

# string literals
def s1 : String = "compiler"
def s2 : String = ""
def s3 : String = "tab\there\nnewline \"quoted\" back\\slash"
def s4 : String = "# not a comment"
def s5 : String = "single ' quote"

# booleans, unit, empty list
def b1 : Bool = True
def b2 : Bool = False
def u1 : () = ()
def l1 : [Integer] = []
