def t35 : T = if a then b else c + d
def t36 : T = (if a then b else c) + d
def i1 : T = if a then b else c
def i2 : T = if a then b else if c then d else e
def i3 : T = if a then if b then c else d else e
def i4 : T = if n == 0 then 1 else n * fact (n - 1)
def i5 : T = (if a then b else c) d
def i6 : T = if f x then g y else h z
def i7 : T = if a && b || c then 1 else 2
def i8 : T = if a then \ (x : Integer) : Integer => x else \ (x : Integer) : Integer => 0
