# lowercase start; letters, digits, underscore and prime afterwards
def a : T = x
def b : T = camelCase
def c : T = snake_case_name
def d : T = x1y2
def e : T = x'
def f : T = x''
def g : T = a_1'b

# names that merely START with a keyword are ordinary identifiers
def h : T = iffy + letter + matches + data1 + type_ + as_ + inx + elsewhere + thenx + andy + defx + importx + withy

# uppercase names are constructors (usable as expressions)
def i : T = Leaf
def j : T = Node
def k : T = Trueish
def l : T = Falsey
def m : T = True1

# namespace!name (no spaces around '!')
def n : T = lib!fun
def o : T = lib!fun x lib2!g
def p : T = a!b + c!d

# '!=' is the comparison operator, never a namespace separator
def q : T = a != b
def r : T = a!=b
def s : T = lib!fun != x
